generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  idUser    Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  salary    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}
